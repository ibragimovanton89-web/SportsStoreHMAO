@page "/admin/prices"
@inject NavigationManager Navigation
@* Старые закладки ведут на склад: цены редактируются внутри карточки товара. *@
@code {
    /// <summary>Перенаправляет прежний раздел цен в единый раздел собственных товаров.</summary>
    protected override void OnInitialized() => Navigation.NavigateTo("/admin/stock", replace: true);
}
