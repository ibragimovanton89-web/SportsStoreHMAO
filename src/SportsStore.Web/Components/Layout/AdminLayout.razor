@* Отдельный макет управления: навигация, текущая личность и выход через antiforgery-защищённый HTTP POST. *@
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SportsStore.Application.Admin
<div class="admin-shell">
<aside class="admin-sidebar"><a class="admin-logo" href="/admin">SPORTSSTORE<small>HMAO · УПРАВЛЕНИЕ</small></a>
<nav aria-label="Разделы управления"><NavLink href="/admin" Match="NavLinkMatch.All">Обзор</NavLink><NavLink href="/admin/purchases">Мои заказы</NavLink><NavLink href="/admin/stock">Мой склад</NavLink><NavLink href="/admin/lookups">Категории и бренды</NavLink><NavLink href="/admin/imports">Импорт прайса</NavLink><NavLink href="/admin/customers">Покупатели</NavLink><NavLink href="/admin/customer-orders">Заказы покупателей</NavLink>
<AuthorizeView Policy="@AdminPolicies.Administrator"><NavLink href="/admin/employees">Сотрудники</NavLink><NavLink href="/admin/audit">Журнал действий</NavLink></AuthorizeView></nav>
<a class="back-store" href="/">Главная магазина ↗</a></aside>
<div class="admin-content"><header class="admin-top"><span>ХМАО — Югра · кабинет сотрудника</span><AuthorizeView><Authorized Context="auth"><span>@auth.User.Identity?.Name</span>@if (SportsStore.Web.Security.DevelopmentAdminAccess.IsDevelopmentPrincipal(auth.User)) { <span class="badge">Тестовый вход · без пароля</span> } else { <a href="/account/password">Пароль</a><form method="post" action="/account/login?handler=Logout" data-enhance="false"><AntiforgeryToken /><button class="secondary" type="submit">Выйти</button></form> }</Authorized></AuthorizeView></header><main id="admin-main">@Body</main></div>
</div>
<div id="blazor-error-ui" role="alert">Соединение прервано. <a href="">Обновить страницу и проверить результат операции</a></div>
