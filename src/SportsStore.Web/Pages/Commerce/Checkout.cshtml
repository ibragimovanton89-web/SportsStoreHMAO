@page "/cart"
@model SportsStore.Web.Pages.Commerce.CheckoutModel
@using SportsStore.Domain.Entities
@using SportsStore.Web.Pages.Commerce
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Серверные формы корзины, подтверждения и личных заказов. Суммы выводятся только из Application DTO. *@
@{ Layout = null; }
<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>@Model.Title · SportsStoreHMAO</title><link rel="stylesheet" href="/app.css"/><link rel="stylesheet" href="/customer.css"/><link rel="stylesheet" href="/commerce.css"/></head>
<body><a class="customer-skip" href="#main">К содержимому</a><header class="customer-header"><a class="brand" href="/">SPORTSSTORE <small>HMAO / ЮГРА</small></a><nav><a href="/catalog">Каталог</a><a href="/cart">Корзина</a><a href="/customer/profile">Личный кабинет</a><a href="/customer/orders">Заказы</a></nav></header>
<main id="main" class="customer-shell"><h1>@Model.Title</h1>
@if(Model.Error is not null) { <p class="customer-error" role="alert">@Model.Error</p> }
@if(Model.Cart is { } cart && Model.Preview is null) {
<p>Применяемые цены: <strong>@(cart.Segment == CustomerSegment.Retail ? "Розничные" : "Оптовые")</strong>. Добавление в корзину не резервирует товар.</p>
@if(cart.Lines.Count == 0) { <section class="customer-panel"><p>Корзина пока пуста.</p><a href="/catalog">Перейти к товарам</a></section> }
@foreach(var line in cart.Lines) { <article class="customer-panel commerce-line"><div><h2>@line.Name</h2><p>@line.Sku · @line.Size @line.Color · @line.Unit</p><p>@(line.Price?.ToString("N2") ?? "—") ₽ / @line.Unit</p>@if(line.Error is not null) { <p class="customer-error">@line.Error</p> }</div>
@if(Model.Mode == "cart") { <form method="post" class="customer-form"><input type="hidden" name="command" value="set"/><input type="hidden" name="VariantId" value="@line.VariantId"/><input type="hidden" name="Version" value="@cart.Version"/><label for="q-@line.VariantId">Количество</label><input id="q-@line.VariantId" name="Quantity" type="number" min="0" max="10000" step="1" value="@(Model.Error is not null && Model.VariantId == line.VariantId ? Model.Quantity.ToString() : line.Quantity.ToString("0"))"/><button>Обновить количество</button></form><form method="post"><input type="hidden" name="command" value="set"/><input type="hidden" name="VariantId" value="@line.VariantId"/><input type="hidden" name="Version" value="@cart.Version"/><input type="hidden" name="Quantity" value="0"/><button>Удалить</button></form> } else { <p>@line.Quantity.ToString("0") @line.Unit</p> }</article> }
<p class="commerce-total">Сумма товаров: @(cart.Total?.ToString("N2") ?? "требует уточнения") @(cart.Total is null ? "" : "₽")</p>
@if(Model.Mode == "cart" && cart.Lines.Count > 0) { <a class="customer-primary commerce-link" href="/checkout">Перейти к оформлению</a> }
}
@if(Model.Mode == "checkout") {
<p>Заказ поступит сотруднику на подтверждение. Доставка и способ оплаты согласуются отдельно; их стоимость в сумму товаров не включена.</p>
@if(Model.Preview is { } preview) { <section class="customer-panel"><h2>Проверьте условия</h2><p>@preview.ContactName · @preview.Email · @preview.Phone</p><p>Получатель: @preview.Recipient</p><p>@preview.Address · @preview.PostalCode</p>@if(preview.Organization is not null) { <p>@preview.Organization · ИНН @preview.Inn · КПП @preview.Kpp</p> }<p>@(preview.Cart.Segment == CustomerSegment.Wholesale ? "Оптовые" : "Розничные") цены</p>@foreach(var l in preview.Cart.Lines) { <p><strong>@l.Name</strong> · @l.Sku · @l.Size @l.Color · @l.Quantity.ToString("0") @l.Unit × @l.Price?.ToString("N2") ₽</p> }<p class="commerce-total">Сумма товаров: @preview.Cart.Total?.ToString("N2") ₽</p><p>Подтвердить до @CheckoutModel.When(preview.ExpiresAt)</p><form method="post"><input type="hidden" name="command" value="submit"/><input type="hidden" asp-for="PreviewId"/><input type="hidden" asp-for="OperationId"/><button class="customer-primary">Отправить заказ</button></form><a href="/checkout">Выбрать другой адрес</a></section> }
else { <section class="customer-panel"><form method="post" class="customer-form"><input type="hidden" name="command" value="preview"/><label for="AddressId">Сохранённый адрес</label><select id="AddressId" name="AddressId" required><option value="">Выберите адрес</option>@foreach(var a in Model.Addresses) { <option value="@a.Id">@a.Recipient · @a.Address</option> }</select><button class="customer-primary">Проверить заказ</button></form><a href="/customer/addresses">Добавить или изменить адрес</a><a href="/customer/profile">Изменить телефон и реквизиты</a></section> }
}
@if(Model.Orders is { } orders) { @foreach(var o in orders.Items) { <article class="customer-panel"><h2><a href="/customer/orders/@o.Id">@o.Number</a></h2><p>@CheckoutModel.Status(o.Status) · @CheckoutModel.When(o.CreatedAt)</p><p>Сумма товаров: @o.Total.ToString("N2") ₽</p><p>Резерв до @CheckoutModel.When(o.ReserveUntil)</p></article> } @if(orders.Count == 0){<p>Заказов пока нет.</p>} <nav>@if(orders.Page > 1){<a href="?PageNumber=@(orders.Page-1)">Назад</a>} @if(orders.Page * 25 < orders.Count){<a href="?PageNumber=@(orders.Page+1)">Далее</a>}</nav> }
@if(Model.Order is { } order) { @if(Request.Query["created"] == "true" && order.Status == CustomerOrderStatus.AwaitingConfirmation) { <p class="customer-success" role="status">Заказ отправлен на подтверждение.</p> } <section class="customer-panel"><h2>@CheckoutModel.Status(order.Status)</h2><p>@CheckoutModel.When(order.CreatedAt) · @(order.Segment == CustomerSegment.Wholesale ? "Опт" : "Розница")</p><p>Резерв до @CheckoutModel.When(order.ReserveUntil)</p><p>@order.ContactName · @order.Email · @order.Phone</p><p>@order.Recipient · @order.Address · @order.PostalCode</p><p>@order.Organization @order.Inn @order.Kpp</p>@foreach(var l in order.Lines){<article><h3>@l.Name</h3><p>@l.Sku · @l.Size @l.Color · @l.Quantity.ToString("0") @l.Unit × @((l.UnitPrice-l.UnitDiscount).ToString("N2")) ₽</p></article>}<p class="commerce-total">Сумма товаров: @order.GoodsTotal.ToString("N2") ₽</p>@if(order.Status == CustomerOrderStatus.AwaitingConfirmation){<form method="post"><input type="hidden" name="command" value="cancel"/><input type="hidden" name="Version" value="@order.Version"/><input type="hidden" asp-for="OperationId"/><button>Отменить заказ</button></form>}<h2>История</h2>@foreach(var e in order.History){<p>@CheckoutModel.When(e.At) · @CheckoutModel.Status(e.Status) · @e.Reason</p>}<a href="/customer/orders">Все мои заказы</a></section> }
</main><footer class="customer-footer">SportsStoreHMAO · ХМАО — Югра</footer></body></html>
